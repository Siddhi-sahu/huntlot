DATABASE_URL=postgresql://huntlot:huntlot@localhost:5433/huntlot

# --- LLM ---------------------------------------------------------------
# Leave OPENAI_API_KEY empty to use Ollama only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# USD per 1M tokens for OPENAI_MODEL; check https://openai.com/api/pricing
OPENAI_PRICE_INPUT=0.15
OPENAI_PRICE_OUTPUT=0.60
# When either is reached, huntlot switches to Ollama
LLM_DAILY_BUDGET_USD=0.20
LLM_TOTAL_BUDGET_USD=2.00

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
